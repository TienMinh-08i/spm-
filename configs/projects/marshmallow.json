{
  "name": "marshmallow",
  "commit": "60a803821466f3e537fa2729d65e1aaf7df9d2a4",
  "source_root": "src",
  "packages": ["marshmallow"],
  "tests": ["tests"],
  "python_path": [".", "src"],
  "docs_dir": "docs",
  "dependencies": ["simplejson==3.20.2", "tzdata==2025.2"],
  "docs_build": {
    "python_version": "3.11",
    "dependency_source": {"file": "pyproject.toml", "group": "docs", "lock": "uv.lock"},
    "requirements": [
      "autodocsumm==0.2.15",
      "furo==2025.12.19",
      "sphinx-copybutton==0.5.2",
      "sphinx-issues==6.0.0",
      "sphinx==9.0.4",
      "sphinxext-opengraph==0.13.0"
    ],
    "install": [
      ["{python}", "-m", "pip", "install", "--no-input", "-r", "{requirements}"],
      ["{python}", "-m", "pip", "install", "--no-input", "--no-deps", "{checkout}"]
    ],
    "build": [
      ["{python}", "-m", "sphinx", "-b", "html", "--fresh-env", "-d", "{doctrees}", "{docs}", "{html}"]
    ],
    "api_reference": "api_reference",
    "pages": [
      "top_level",
      "marshmallow.schema",
      "marshmallow.fields",
      "marshmallow.decorators",
      "marshmallow.validate",
      "marshmallow.utils",
      "marshmallow.experimental.context",
      "marshmallow.exceptions"
    ],
    "required_anchors": [
      "marshmallow.schema.Schema.load",
      "marshmallow.utils.set_value"
    ]
  }
}
